# pnpm-only monorepo: install once from root (`pnpm install`).
# Never run `npm install` / `npm add` inside apps/* or packages/* —
# that creates nested node_modules + package-lock.json and breaks workspace links.
link-workspace-packages=true
prefer-workspace-packages=true
shamefully-hoist=false
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true
