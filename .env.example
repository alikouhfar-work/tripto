# Copy to .env and fill in real values. Never commit .env.
# Database (docker-compose: postgres:17 on 5433)
DATABASE_USER=admin
DATABASE_PASSWORD=change-me
DATABASE_DB=tripto
DATABASE_URL=postgresql://admin:change-me@localhost:5433/tripto

# Storage
# Development defaults to self-hosted MinIO (docker-compose: minio on 9000/9001).
# Production defaults to Filebase (S3-compatible) — no STORAGE_PROVIDER needed.
# Override explicitly with STORAGE_PROVIDER=minio|s3 when required.
STORAGE_PROVIDER=minio
STORAGE_MINIO_ENDPOINT=localhost
STORAGE_MINIO_PORT=9000
STORAGE_MINIO_USER=admin
STORAGE_MINIO_PASSWORD=change-me

# Production storage (Filebase, S3-compatible)
# STORAGE_PROVIDER=s3
# STORAGE_S3_ENDPOINT=https://s3.filebase.com
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Auth (dashboard + future client auth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
